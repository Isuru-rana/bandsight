#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    getent group bandsight >/dev/null || addgroup --system bandsight
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        if [ -z "$2" ]; then
            # First install. An upgrade ($2 = the previous version) must not
            # re-enable or start a daemon the admin turned off.
            systemctl enable bandsightd.service >/dev/null 2>&1 || true
            systemctl restart bandsightd.service || true
        else
            systemctl try-restart bandsightd.service || true
        fi
        if ! systemctl is-enabled --quiet bandsightd.service 2>/dev/null; then
            echo "bandsight: the collector is not enabled; start it with:"
            echo "    sudo systemctl enable --now bandsightd"
        fi
    fi
    echo "bandsight: add yourself to the 'bandsight' group to use the GUI:"
    echo "    sudo usermod -aG bandsight \$USER   (then log out and back in)"
fi
exit 0
