post_install() {
  getent group bandsight >/dev/null || groupadd --system bandsight
  systemctl daemon-reload
  echo "Enable the collector:  sudo systemctl enable --now bandsightd"
  echo "Use the GUI as yourself: sudo usermod -aG bandsight \$USER  (then log out and back in)"
}

post_upgrade() {
  systemctl daemon-reload
  systemctl try-restart bandsightd.service || true
}

pre_remove() {
  systemctl disable --now bandsightd.service >/dev/null 2>&1 || true
}
